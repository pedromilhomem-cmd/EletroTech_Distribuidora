<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="600.0" prefWidth="800.0" style="-content-background-color: #e0e0e0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.view.ClienteController">
   <children>
      <Pane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f4f4; -fx-background-radius: 10;">
         <children>
            <Label layoutX="275.0" layoutY="14.0" text="Cadastro de Clientes">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>

            <Label layoutX="50.0" layoutY="70.0" text="Nome" />
            <TextField fx:id="txtNome" layoutX="50.0" layoutY="90.0" prefHeight="30.0" prefWidth="250.0" promptText="Nome Completo" />

            <Label layoutX="320.0" layoutY="70.0" text="CPF/CNPJ" />
            <TextField fx:id="txtDocumento" layoutX="320.0" layoutY="90.0" prefHeight="30.0" prefWidth="180.0" promptText="000.000.000-00" />

            <Label layoutX="520.0" layoutY="70.0" text="E-mail" />
            <TextField fx:id="txtEmail" layoutX="520.0" layoutY="90.0" prefHeight="30.0" prefWidth="130.0" promptText="email@exemplo.com" />

            <Label layoutX="50.0" layoutY="130.0" text="Telefone" />
            <TextField fx:id="txtTelefone" layoutX="50.0" layoutY="150.0" prefHeight="30.0" prefWidth="150.0" promptText="(00) 00000-0000" />

            <Label layoutX="220.0" layoutY="130.0" text="Status" />
            <ComboBox fx:id="cbStatus" layoutX="220.0" layoutY="150.0" prefHeight="30.0" prefWidth="120.0" />

            <Label layoutX="50.0" layoutY="200.0" text="Buscar Cliente (Nome, CPF ou E-mail)" />
            <TextField fx:id="txtBusca" layoutX="50.0" layoutY="220.0" prefHeight="35.0" prefWidth="480.0" />
            <Button fx:id="btnBuscar" layoutX="540.0" layoutY="220.0" mnemonicParsing="false" onAction="#handleBuscar" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #4ed9c6; -fx-background-radius: 20;" text="Buscar" textFill="WHITE" />

            <Button fx:id="btnSalvar" layoutX="100.0" layoutY="280.0" mnemonicParsing="false" onAction="#handleSalvar" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: #4ed9c6; -fx-background-radius: 30;" text="Salvar Cliente" textFill="WHITE" />
            <Button fx:id="btnExcluir" layoutX="380.0" layoutY="280.0" mnemonicParsing="false" onAction="#handleExcluir" prefHeight="45.0" prefWidth="220.0" style="-fx-background-color: #4ed9c6; -fx-background-radius: 30;" text="Excluir" textFill="WHITE" />

            <TableView fx:id="tblClientes" layoutX="42.0" layoutY="355.0" prefHeight="170.0" prefWidth="660.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                <TableColumn fx:id="colNome" prefWidth="150.0" text="Nome" />
                <TableColumn fx:id="colDocumento" prefWidth="120.0" text="CPF/CNPJ" />
                <TableColumn fx:id="colEmail" prefWidth="150.0" text="E-mail" />
                <TableColumn fx:id="colStatus" prefWidth="80.0" text="Status" />
                <TableColumn fx:id="colUltimaCompra" prefWidth="120.0" text="Última Compra" />
              </columns>
            </TableView>
         </children>
      </Pane>
   </children>
</AnchorPane>
