<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #F4F4F4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com" fx:controller="application.view.CadastroUsuarioController">
   <children>
      <!-- Título -->
      <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Cadastro de Usuários" textFill="#333333">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Label>

      <!-- Formulário de Cadastro -->
      <GridPane hgap="15.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Nome Completo" GridPane.columnSpan="2" />
            <TextField fx:id="txtNome" promptText="Digite o nome do funcionário" style="-fx-background-radius: 5;" GridPane.columnSpan="2" GridPane.rowIndex="1" />
            
            <Label text="Nível de Acesso" GridPane.columnIndex="2" />
            <ComboBox fx:id="cbPerfil" maxWidth="1.7976931348623157E308" promptText="Selecione" style="-fx-background-radius: 5;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            
            <Label text="Login (Usuário)" GridPane.rowIndex="2" />
            <TextField fx:id="txtLogin" promptText="ex: joao.silva" style="-fx-background-radius: 5;" GridPane.rowIndex="3" />
            
            <Label text="Senha" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <PasswordField fx:id="txtSenha" style="-fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            
            <Label text="Confirmar Senha" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <PasswordField fx:id="txtConfirmaSenha" style="-fx-background-radius: 5;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
         </children>
         <VBox.margin>
            <Insets left="40.0" right="40.0" />
         </VBox.margin>
      </GridPane>

      <!-- Botões de Ação -->
      <HBox alignment="CENTER" spacing="20.0">
         <children>
            <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#handleSalvarUsuario" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #FF8C00; -fx-background-radius: 30; -fx-cursor: hand;" text="Salvar Usuário" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            
            <Button fx:id="btnExcluir" mnemonicParsing="false" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #FF7F50; -fx-background-radius: 30; -fx-cursor: hand;" text="Excluir" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>

      <!-- Tabela de Usuários -->
      <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome" />
            <TableColumn fx:id="colLogin" prefWidth="150.0" text="Login" />
            <TableColumn fx:id="colPerfil" prefWidth="150.0" text="Nível" />
            <TableColumn fx:id="colUltimoAcesso" prefWidth="120.0" text="Último Acesso" />
        </columns>
         <VBox.margin>
            <Insets bottom="20.0" left="40.0" right="40.0" />
         </VBox.margin>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
